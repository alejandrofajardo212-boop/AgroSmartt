{
  "name": "agrosmart",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de agricultura inteligente",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "test": "npm --workspace apps/api test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
